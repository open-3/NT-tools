{
  "name": "agent-pulse",
  "version": "0.1.22",
  "private": true,
  "description": "并发 Agent 状态浮窗 — 只读聚合 Codex / DeepSeek Harness / WorkBuddy 的进行中与未确认会话",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-3/NT-tools.git"
  },
  "main": "dist/main/main.js",
  "author": "Agent Pulse",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build": "node scripts/build-main.mjs && node scripts/build-renderer.mjs",
    "start": "node scripts/launch.mjs",
    "dev": "npm run build && node scripts/launch.mjs -- --dev",
    "test": "node scripts/test.mjs",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "electron": "45.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.agentpulse.app",
    "productName": "Agent Pulse",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "open-3",
        "repo": "NT-tools"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Pulse",
      "artifactName": "AgentPulse-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.11",
    "jsqr": "^1.4.0",
    "monaco-editor": "^0.57.0",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  }
}
